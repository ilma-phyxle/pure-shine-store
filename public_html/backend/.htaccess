<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Deny access to sensitive files
    RewriteRule ^(.env|composer.json|composer.lock|package.json|package-lock.json|artisan|storage/logs/.*|storage/framework/.*)$ - [F,L]
    
    # 2. Deny access to core directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)/.*$ - [F,L]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 5. Serve existing files/folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Fallback to index.php
    RewriteRule ^ index.php [L]
</IfModule>
