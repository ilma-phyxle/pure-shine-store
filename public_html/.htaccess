<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # 1. Skip rewrites for the /backend directory (let Laravel handle itself)
    RewriteRule ^backend/ - [L]

    # 2. Skip existing files and directories (so assets like .js, .css work)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # 3. SPA Fallback: Everything else goes to index.html (React)
    RewriteRule ^ index.html [L]
</IfModule>
